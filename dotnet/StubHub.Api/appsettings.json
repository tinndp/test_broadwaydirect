{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "// Fetch": "tuning for StubHubClient - see StubHub.Fetch/StubHubFetchOptions.cs. Per-request useGridPost/concurrency/batchDelay override these.",
  "Fetch": {
    "Concurrency": 3,
    "BatchDelaySeconds": 1.0,
    "Retries": 3,
    "NavRetries": 4,
    "TimeoutSeconds": 25,
    "ChallengeWaitSeconds": 8.0,
    "RetryPasses": 2,
    "RetryPassDelaySeconds": 15.0,
    "GridPageSize": 2000,
    "UseGridPost": true
  }
}
